# LLM Provider: ollama | openrouter
LLM_PROVIDER=ollama

# Ollama (free testing)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2

# OpenRouter (fallback)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Rate Limiting
RATE_LIMIT_PER_IP=3/5minutes
RATE_LIMIT_PER_CONVERSATION=12/day

# CORS
CORS_ORIGINS=http://localhost:3000

# PII Allowlist (comma-separated emails/phones that should NOT be redacted)
ALLOWED_EMAILS=
ALLOWED_PHONES=

# Personal Info
PERSONAL_NAME=
PERSONAL_EMAIL=
PERSONAL_GITHUB=
PERSONAL_LINKEDIN=
PERSONAL_TITLE=

# Neon PostgreSQL (Phase 2)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Embedding API (Jina AI — 10M free tokens, no credit card)
# API is OpenAI-compatible at https://api.jina.ai/v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3

# App
LOG_LEVEL=info